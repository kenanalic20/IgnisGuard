# ===== FIREBASE CONFIGURATION =====
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com
FIREBASE_ROOT_PATH=/
FIREBASE_DEVICE_ID=esp32
FIREBASE_INPUT_ENABLED=true
FIREBASE_INPUT_PATH=esp32
FIREBASE_INPUT_POLL_SECONDS=1.0

# ===== EMAIL ALERTS (SendGrid) =====
EMAIL_ENABLED=false
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@ignisguard.com
EMAIL_RECIPIENTS=admin@example.com,user@example.com

# ===== CAMERA CONFIGURATION (optional) =====
CAMERA_ENABLED=false
CAMERA_INDEX=0
CAMERA_OUTPUT_DIR=./captures